{
  "name": "demir-baronu-app",
  "version": "1.0.0",
  "private": true,
  "description": "iOS app shell for Demir Baronu (Capacitor). The game itself lives in ../web/play.html.",
  "scripts": {
    "build:web": "node scripts/build-web.mjs",
    "sync": "npm run build:web && npx cap sync ios",
    "assets": "npx capacitor-assets generate --ios --iconBackgroundColor '#101418' --splashBackgroundColor '#101418' --splashBackgroundColorDark '#101418'"
  },
  "dependencies": {
    "@capacitor/core": "8.6.0",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/ios": "8.6.0",
    "@capacitor/preferences": "8.0.1",
    "@capacitor/status-bar": "8.0.4"
  },
  "devDependencies": {
    "@capacitor/assets": "4.0.0",
    "@capacitor/cli": "8.6.0",
    "@fontsource/chakra-petch": "5.3.0",
    "@fontsource/nunito": "5.3.0",
    "@fontsource/saira-condensed": "5.3.0"
  }
}
